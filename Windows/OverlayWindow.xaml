<Window x:Class="MeaningOverlay.Windows.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MeaningOverlay"
        Width="500"
        SizeToContent="Height"
        MaxHeight="700"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Spinner animation storyboard -->
        <Storyboard x:Key="SpinStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="SpinnerRotation"
                             Storyboard.TargetProperty="Angle"
                             From="0" To="360"
                             Duration="0:0:1"/>
        </Storyboard>

        <!-- Fade-in for the card -->
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetName="RootCard"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1"
                             Duration="0:0:0.25"/>
            <ThicknessAnimation Storyboard.TargetName="RootCard"
                                Storyboard.TargetProperty="Margin"
                                From="0,16,0,0" To="0,0,0,0"
                                Duration="0:0:0.25">
                <ThicknessAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </ThicknessAnimation.EasingFunction>
            </ThicknessAnimation>
        </Storyboard>

        <!-- Fade-out -->
        <Storyboard x:Key="FadeOutStoryboard" Completed="FadeOut_Completed">
            <DoubleAnimation Storyboard.TargetName="RootCard"
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0"
                             Duration="0:0:0.18"/>
        </Storyboard>

        <!-- Close button style -->
        <Style x:Key="CloseBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="#9090B0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Drop shadow outer wrapper -->
    <Border Padding="16">
        <Border x:Name="RootCard"
                CornerRadius="16"
                Opacity="0"
                Background="#E60D0D1A"
                BorderBrush="#553D3D5C"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="0" Color="#7C3AED" Opacity="0.25"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- header -->
                    <RowDefinition Height="Auto"/>
                    <!-- snippet -->
                    <RowDefinition Height="Auto"/>
                    <!-- divider -->
                    <RowDefinition Height="Auto"/>
                    <!-- result -->
                    <RowDefinition Height="Auto"/>
                    <!-- footer hint -->
                </Grid.RowDefinitions>

                <!-- ═══ HEADER ═══ -->
                <Border Grid.Row="0" CornerRadius="16,16,0,0" Padding="18,14,14,14">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#207C3AED" Offset="0"/>
                            <GradientStop Color="#15A855F7" Offset="0.6"/>
                            <GradientStop Color="#1006B6D4" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon + Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="✦" FontSize="18" Foreground="#A855F7" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Meaning Overlay" FontSize="14" FontWeight="SemiBold"
                                       Foreground="#F0F0FF" VerticalAlignment="Center"
                                       FontFamily="{StaticResource MainFont}"/>
                        </StackPanel>

                        <!-- Mode badge + shortcut hint -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border x:Name="ModeBadge" CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                    Background="#20A855F7">
                                <TextBlock x:Name="ModeBadgeText" Text="⚡ Simple"
                                           FontSize="10" Foreground="#A855F7"
                                           FontFamily="{StaticResource MainFont}"/>
                            </Border>
                            <TextBlock Text="Ctrl+Shift+M" FontSize="11"
                                       Foreground="#7070A0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Close button -->
                        <Button Grid.Column="2" Style="{StaticResource CloseBtn}"
                                Content="✕" Click="CloseBtn_Click" ToolTip="Close (Esc)"/>
                    </Grid>
                </Border>

                <!-- ═══ SNIPPET (copied text) ═══ -->
                <Border Grid.Row="1" Padding="18,12,18,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="📋" FontSize="13" Foreground="#605080"
                                   VerticalAlignment="Top" Margin="0,1,8,0"/>
                        <TextBlock Grid.Column="1" x:Name="SnippetText"
                                   Text="Loading…"
                                   Foreground="#706090"
                                   FontSize="12.5"
                                   FontStyle="Italic"
                                   TextWrapping="Wrap"
                                   MaxHeight="60"
                                   TextTrimming="CharacterEllipsis"
                                   FontFamily="{StaticResource MainFont}"/>
                    </Grid>
                </Border>

                <!-- ═══ DIVIDER ═══ -->
                <Rectangle Grid.Row="2" Height="1" Fill="#22FFFFFF" Margin="18,0,18,0"/>

                <!-- ═══ CONTENT AREA (scrollable) ═══ -->
                <Border Grid.Row="3" Padding="18,14,6,14" MinHeight="70">
                    <ScrollViewer x:Name="ContentScroller"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  MaxHeight="420"
                                  Padding="0,0,10,0"
                                  PreviewMouseWheel="ContentScroller_MouseWheel">
                        <ScrollViewer.Resources>
                            <!-- Thumb Style -->
                            <Style x:Key="OverlayScrollThumb" TargetType="Thumb">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#44332266" CornerRadius="3" Margin="1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="#887C3AED"/>
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>

                            <!-- Thin dark scrollbar style -->
                            <Style TargetType="ScrollBar">
                                <Setter Property="Width" Value="6"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ScrollBar">
                                            <Grid>
                                                <Border Background="#1A1A2E" CornerRadius="3"/>
                                                <Track x:Name="PART_Track" IsDirectionReversed="True">
                                                    <Track.Thumb>
                                                        <Thumb Style="{StaticResource OverlayScrollThumb}"/>
                                                    </Track.Thumb>
                                                </Track>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ScrollViewer.Resources>

                        <!-- Inner grid: all three state panels stacked -->
                        <Grid>
                            <!-- Loading state -->
                            <Grid x:Name="LoadingPanel" Visibility="Visible">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            VerticalAlignment="Center" Margin="0,8">
                                    <Canvas Width="24" Height="24" Margin="0,0,12,0">
                                        <Canvas.RenderTransform>
                                            <RotateTransform x:Name="SpinnerRotation" CenterX="12" CenterY="12"/>
                                        </Canvas.RenderTransform>
                                        <Path Data="M12,2 A10,10 0 0,1 22,12"
                                              Stroke="#A855F7" StrokeThickness="2.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Fill="Transparent"/>
                                        <Path Data="M22,12 A10,10 0 0,1 12,22"
                                              Stroke="#7C3AED" StrokeThickness="2.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              Fill="Transparent" Opacity="0.5"/>
                                    </Canvas>
                                    <TextBlock x:Name="LoadingText"
                                               Text="Asking Gemini…" FontSize="13" Foreground="#9090B0"
                                               VerticalAlignment="Center" FontFamily="{StaticResource MainFont}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Result state -->
                            <TextBlock x:Name="ResultText"
                                       Visibility="Collapsed"
                                       TextWrapping="Wrap"
                                       Foreground="#F0F0FF"
                                       FontSize="14"
                                       LineHeight="22"
                                       FontFamily="{StaticResource MainFont}"/>

                            <!-- Error state -->
                            <Border x:Name="ErrorPanel" Visibility="Collapsed"
                                    Background="#20FF4444" CornerRadius="8" Padding="12,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚠ " FontSize="14" Foreground="#FF6B6B"/>
                                    <TextBlock x:Name="ErrorText" TextWrapping="Wrap"
                                               Foreground="#FF9090" FontSize="13"
                                               FontFamily="{StaticResource MainFont}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Border>

                <!-- ═══ FOOTER ═══ -->
                <Border Grid.Row="4" CornerRadius="0,0,16,16" Padding="18,8,18,12">
                    <Border.Background>
                        <SolidColorBrush Color="#0A0A14" Opacity="0.5"/>
                    </Border.Background>
                    <TextBlock Text="Press Esc or click outside to dismiss"
                               FontSize="11" Foreground="#505070"
                               HorizontalAlignment="Center"
                               FontFamily="{StaticResource MainFont}"/>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
