<Window x:Class="MeaningOverlay.Windows.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Meaning Overlay — Settings"
        Width="460" SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Topmost="True">

    <Window.Resources>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#12121E"/>
            <Setter Property="Foreground" Value="#E0E0F0"/>
            <Setter Property="CaretBrush" Value="#A855F7"/>
            <Setter Property="BorderBrush" Value="#3D3D5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Consolas, monospace"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#7C3AED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#7C3AED" Offset="0"/>
                        <GradientStop Color="#A855F7" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="24,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E1E30"/>
            <Setter Property="Foreground" Value="#9090B0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#3D3D5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="#12121E"/>
            <Setter Property="Foreground" Value="#E0E0F0"/>
            <Setter Property="CaretBrush" Value="#A855F7"/>
            <Setter Property="BorderBrush" Value="#3D3D5C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="10,8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Background="Transparent"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#7C3AED"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Padding="12">
        <Border CornerRadius="16"
                Background="#F00D0D1A"
                BorderBrush="#553D3D5C"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="0" Color="#000000" Opacity="0.6"/>
            </Border.Effect>

            <StackPanel>
                <!-- Header -->
                <Border CornerRadius="16,16,0,0" Padding="24,18,16,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#207C3AED" Offset="0"/>
                            <GradientStop Color="#1006B6D4" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="✦ Meaning Overlay" FontSize="18" FontWeight="Bold"
                                       Foreground="#F0F0FF" FontFamily="Segoe UI Variable, Segoe UI"/>
                            <TextBlock Text="Settings" FontSize="12" Foreground="#8080A0"
                                       Margin="0,2,0,0" FontFamily="Segoe UI Variable, Segoe UI"/>
                        </StackPanel>

                        <!-- Drag handle area -->
                        <Border Grid.Column="0" Background="Transparent" MouseLeftButtonDown="Header_MouseDown" Cursor="SizeAll"/>

                        <Button Grid.Column="1" Click="Cancel_Click"
                                Style="{StaticResource SecondaryBtn}"
                                Content="✕" Width="30" Padding="0" Height="30"/>
                    </Grid>
                </Border>

                <!-- Content -->
                <StackPanel Margin="24,20,24,24">
                    <!-- API Key -->
                    <TextBlock Text="Gemini API Key" FontSize="12" FontWeight="SemiBold"
                               Foreground="#9090B0" Margin="0,0,0,6"
                               FontFamily="Segoe UI Variable, Segoe UI"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <PasswordBox x:Name="ApiKeyBox"
                                     Grid.Column="0"
                                     Style="{StaticResource PasswordBoxStyle}"
                                     Height="38"/>
                        <Button Grid.Column="1" Content="👁" Style="{StaticResource SecondaryBtn}"
                                Width="38" Height="38" Padding="0" Margin="6,0,0,0"
                                Click="ToggleShowKey_Click" ToolTip="Show/hide key"/>
                    </Grid>

                    <!-- Visible key text (shown when toggle active) -->
                    <TextBox x:Name="ApiKeyVisible"
                             Style="{StaticResource InputStyle}"
                             Visibility="Collapsed"
                             Height="38"
                             Margin="0,0,44,0"/>

                    <TextBlock Margin="0,6,0,0" FontSize="11" Foreground="#505070"
                               FontFamily="Segoe UI Variable, Segoe UI">
                        Get your key at
                        <Hyperlink NavigateUri="https://aistudio.google.com/app/apikey"
                                   RequestNavigate="Link_Navigate"
                                   Foreground="#7C3AED">
                            aistudio.google.com
                        </Hyperlink>
                        — it's free.
                    </TextBlock>

                    <!-- ── AI Provider toggle ── -->
                    <Rectangle Height="1" Fill="#15FFFFFF" Margin="0,18,0,18"/>

                    <TextBlock Text="Primary AI Provider" FontSize="12" FontWeight="SemiBold"
                               Foreground="#9090B0" Margin="0,0,0,10"
                               FontFamily="Segoe UI Variable, Segoe UI"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Pollinations button -->
                        <Border x:Name="PollinationsBtn" Grid.Column="0"
                                Background="#1A1A30" CornerRadius="10"
                                BorderBrush="#7C3AED" BorderThickness="2"
                                Padding="12,10" Cursor="Hand"
                                MouseLeftButtonDown="Pollinations_Click">
                            <StackPanel>
                                <TextBlock Text="⚡ Pollinations" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#F0F0FF" Margin="0,0,0,4"
                                           FontFamily="Segoe UI Variable, Segoe UI"/>
                                <TextBlock Text="Free, ultra-fast open-source reasoning model."
                                           FontSize="11" Foreground="#8080A0" TextWrapping="Wrap"
                                           FontFamily="Segoe UI Variable, Segoe UI"/>
                            </StackPanel>
                        </Border>

                        <!-- Gemini button -->
                        <Border x:Name="GeminiBtn" Grid.Column="2"
                                Background="#12121E" CornerRadius="10"
                                BorderBrush="#3D3D5C" BorderThickness="2"
                                Padding="12,10" Cursor="Hand"
                                MouseLeftButtonDown="Gemini_Click">
                            <StackPanel>
                                <TextBlock Text="✨ Gemini API" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#9090B0" Margin="0,0,0,4"
                                           FontFamily="Segoe UI Variable, Segoe UI"/>
                                <TextBlock Text="Uses your personal Google Studio API key limit."
                                           FontSize="11" Foreground="#606080" TextWrapping="Wrap"
                                           FontFamily="Segoe UI Variable, Segoe UI"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ── Answer Mode toggle ── -->
                    <Rectangle Height="1" Fill="#15FFFFFF" Margin="0,18,0,18"/>

                    <TextBlock Text="Answer Mode" FontSize="12" FontWeight="SemiBold"
                               Foreground="#9090B0" Margin="0,0,0,10"
                               FontFamily="Segoe UI Variable, Segoe UI"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Simple Mode button -->
                        <Border x:Name="SimpleModeBtn" Grid.Column="0"
                                Background="#1A1A30" CornerRadius="10"
                                BorderBrush="#7C3AED" BorderThickness="2"
                                Padding="12,10" Cursor="Hand"
                                MouseLeftButtonDown="SimpleMode_Click">
                            <StackPanel>
                                <TextBlock Text="⚡ Simple" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#F0F0FF" Margin="0,0,0,4"
                                           FontFamily="Segoe UI Variable, Segoe UI"/>
                                <TextBlock Text="Quick, plain-English summary. Best for everyday use."
                                           FontSize="11" Foreground="#8080A0" TextWrapping="Wrap"
                                           FontFamily="Segoe UI Variable, Segoe UI"/>
                            </StackPanel>
                        </Border>

                        <!-- Detailed Mode button -->
                        <Border x:Name="DetailedModeBtn" Grid.Column="2"
                                Background="#12121E" CornerRadius="10"
                                BorderBrush="#3D3D5C" BorderThickness="2"
                                Padding="12,10" Cursor="Hand"
                                MouseLeftButtonDown="DetailedMode_Click">
                            <StackPanel>
                                <TextBlock Text="🔍 Detailed" FontSize="13" FontWeight="SemiBold"
                                           Foreground="#9090B0" Margin="0,0,0,4"
                                           FontFamily="Segoe UI Variable, Segoe UI"/>
                                <TextBlock Text="In-depth explanation with examples and context."
                                           FontSize="11" Foreground="#606080" TextWrapping="Wrap"
                                           FontFamily="Segoe UI Variable, Segoe UI"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Divider -->
                    <Rectangle Height="1" Fill="#15FFFFFF" Margin="0,18,0,20"/>

                    <!-- Hotkey info -->
                    <Border Background="#0E0E1A" CornerRadius="10" Padding="14,12">
                        <StackPanel>
                            <TextBlock Text="How to use" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#7C3AED" Margin="0,0,0,8"
                                       FontFamily="Segoe UI Variable, Segoe UI"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="#1E1E30" CornerRadius="4" Padding="6,3">
                                    <TextBlock Text="1." FontSize="12" Foreground="#A855F7" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="  Select &amp; copy any text (Ctrl+C)" FontSize="12"
                                           Foreground="#9090B0" VerticalAlignment="Center"
                                           FontFamily="Segoe UI Variable, Segoe UI"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Background="#1E1E30" CornerRadius="4" Padding="6,3">
                                    <TextBlock Text="2." FontSize="12" Foreground="#A855F7" FontWeight="Bold"/>
                                </Border>
                                <TextBlock FontSize="12" Foreground="#9090B0" VerticalAlignment="Center"
                                           FontFamily="Segoe UI Variable, Segoe UI">
                                    <Run Text="  Press "/>
                                    <Run Text="Ctrl+Shift+M" Foreground="#F0F0FF" FontWeight="SemiBold"/>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Background="#1E1E30" CornerRadius="4" Padding="6,3">
                                    <TextBlock Text="3." FontSize="12" Foreground="#A855F7" FontWeight="Bold"/>
                                </Border>
                                <TextBlock Text="  Read the explanation!" FontSize="12"
                                           Foreground="#9090B0" VerticalAlignment="Center"
                                           FontFamily="Segoe UI Variable, Segoe UI"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Status message -->
                    <TextBlock x:Name="StatusText" Margin="0,12,0,0"
                               FontSize="12" HorizontalAlignment="Center"
                               FontFamily="Segoe UI Variable, Segoe UI"
                               Visibility="Collapsed"/>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Cancel" Style="{StaticResource SecondaryBtn}"
                                Margin="0,0,10,0" Click="Cancel_Click"/>
                        <Button Content="Save Settings" Style="{StaticResource PrimaryBtn}"
                                Click="Save_Click"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Border>
</Window>
