<Application x:Class="MeaningOverlay.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Color Palette -->
        <Color x:Key="BackgroundColor">#0D0D1A</Color>
        <Color x:Key="GlassColor">#1A1A2E</Color>
        <Color x:Key="AccentColor">#7C3AED</Color>
        <Color x:Key="AccentGlowColor">#A855F7</Color>
        <Color x:Key="TextPrimaryColor">#F0F0FF</Color>
        <Color x:Key="TextSecondaryColor">#9090B0</Color>
        <Color x:Key="BorderGlassColor">#3D3D5C</Color>

        <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
        <SolidColorBrush x:Key="GlassBrush" Color="{StaticResource GlassColor}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="AccentGlowBrush" Color="{StaticResource AccentGlowColor}" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
        <SolidColorBrush x:Key="BorderGlassBrush" Color="{StaticResource BorderGlassColor}" />

        <FontFamily x:Key="MainFont">Segoe UI Variable, Segoe UI, sans-serif</FontFamily>

        <!-- Gradient for overlay header -->
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#7C3AED" Offset="0"/>
            <GradientStop Color="#A855F7" Offset="0.5"/>
            <GradientStop Color="#06B6D4" Offset="1"/>
        </LinearGradientBrush>
    </Application.Resources>
</Application>
